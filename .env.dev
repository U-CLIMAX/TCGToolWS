# ==========================================
# 🌐 站点与路由配置
# ==========================================
# 前端站点的完整基础 URL
VITE_WEBSITE_URL=
# 前端开发伺服器或正式上线的 URL (后端用，须和 VITE_WEBSITE_URL 配置一样，用于 CORS 设定与信件连结拼接，例如: http://localhost:5173)
FRONTEND_URL=

# ==========================================
# 🖼️ 卡牌图片与 CDN 配置 (Vite 注入前端)
# ==========================================
# 原始图片来源 URL (中国大陆)
VITE_IMAGE_BASE_URL=
# 模糊图片来源 URL (中国大陆)
VITE_BLUR_IMAGE_BASE_URL=
# 原始图片来源 URL (境外)
VITE_IMAGE_GLOBAL_URL=
# 模糊图片来源 URL (境外)
VITE_BLUR_IMAGE_GLOBAL_URL=

# ==========================================
# 📊 网站数据分析 (Umami Analytics)
# ==========================================
# Umami 追踪脚本的来源网址 (例如: https://analytics.umami.is/script.js)
VITE_UMAMI_SCRIPT_URL=
# 您的网站在 Umami 后台对应的唯一 UUID
VITE_UMAMI_ID=
# Umami 报表公开分享的连结 (使开发者角色可查看 Umami 后台的「分享报表」功能)
VITE_UMAMI_SHARE_URL=

# ==========================================
# 🔒 后端鉴权与安全密钥 (Hono / Cloudflare Workers)
# ==========================================
# JSON Web Token (JWT) 加解密私钥 (极重要！请勿外泄)
# 注：本项目采用 HS256 演算法，推荐使用 Node.js 终端生成高强度乱码填入：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 爱发电 (Afdian) 官方提供的 RSA 公钥 (PEM 格式，用于验证 Webhook 签名)
AFDIAN_PUBLIC_KEY=
# 本地开发金流测试的「安全后门」绕过令牌 (配合 npm run test:webhook 使用，正式环境无须填写)
AFDIAN_WEBHOOK_BYPASS_TOKEN=dev_sign_bypass_123

# ==========================================
# ✉️ 第三方服务与爬虫代理 API
# ==========================================
# Brevo (前 Sendinblue) 邮件服务的 API 密钥 (用于发送验证码、密码重置信件)
BREVO_API_KEY=
# 第三方爬虫代理服务 (ScraperAPI) 的密钥 (对外请求失败时的 fallback 方案)
# 支持填入多个 Token 进行轮替，请使用逗号 (,) 分隔 (参考: https://www.scraperapi.com/)
SCRAPER_API_KEY=